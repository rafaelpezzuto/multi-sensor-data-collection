<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/microphone"
        android:contentDescription="@string/microphone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/background_dark"
        android:src="@android:drawable/ic_btn_speak_now"
        android:scaleType="centerInside"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/top_timer_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_top_info_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/clock_textview"
            android:fontFamily="monospace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:text="@string/timer_zero" />

        <TextView
            android:id="@+id/recording_textview"
            android:fontFamily="monospace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/teal_200"
            android:layout_marginStart="8dp"
            android:textAllCaps="true"
            android:text="@string/recording_status_stopped" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/important_information_linear_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_top_info_pill"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:layout_marginEnd="12dp"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:layout_gravity="end">

            <ImageView
                android:id="@+id/angle_icon_image_view"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_device_angle"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/angle_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:textIsSelectable="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:text="@string/degree_zero" />

            <ImageView
                android:id="@+id/gps_icon_image_view"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_gps_marker"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/gps_status_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:textIsSelectable="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:text="" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:layout_gravity="end"
            android:layout_marginTop="2dp">

            <ImageView
                android:id="@+id/storage_icon_image_view"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_storage_memory"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/memory_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:textIsSelectable="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:text="" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/output_and_recording_mode_settings_linear_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_output_panel"
        android:layout_marginTop="6dp"
        android:padding="10dp"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="@id/important_information_linear_layout"
        app:layout_constraintTop_toBottomOf="@id/important_information_linear_layout">

        <TextView
            android:id="@+id/output_dir_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/output_dir_title"
            android:textAlignment="textStart"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textColor="@color/teal_200" />

        <EditText
            android:id="@+id/dir_edittext"
            tools:ignore="LabelFor"
            android:hint="@string/dir_title"
            android:textColorHint="#B0E0F2F1"
            android:textAlignment="textStart"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_width="130dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/teal_200"
            android:textColor="@color/white"
            android:inputType="textCapCharacters"
            android:autofillHints="Enter the directory name" />

        <EditText
            android:id="@+id/subdir_edittext"
            tools:ignore="LabelFor"
            android:hint="@string/subdir_title"
            android:textColorHint="#B0E0F2F1"
            android:textAlignment="textStart"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_width="130dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/teal_200"
            android:textColor="@color/white"
            android:inputType="textCapCharacters"
            android:autofillHints="Enter the subdirectory name" />

        <RadioGroup
            android:id="@+id/recording_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/recording_mode_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recording_mode_title"
                android:textAlignment="textStart"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="@color/teal_200" />

            <RadioButton
                android:id="@+id/radio_audio_video"
                android:checked="true"
                android:buttonTint="@color/teal_200"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:text="@string/recording_mode_audio_video"
                android:textColor="@color/white"
                android:background="?attr/selectableItemBackground"
                android:gravity="center" />

            <RadioButton
                android:id="@+id/radio_audio"
                android:buttonTint="@color/teal_200"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:text="@string/recording_mode_audio"
                android:textColor="@color/white"
                android:background="?attr/selectableItemBackground"
                android:gravity="center" />
        </RadioGroup>
    </LinearLayout>

    <TextView
        android:id="@+id/status_textview"
        android:fontFamily="monospace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="380dp"
        android:layout_marginBottom="12dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:textAlignment="center"
        android:text=""
        android:visibility="invisible"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_status_pill"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/main_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/main_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center">

        <ImageButton
            android:id="@+id/history_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_side_button"
            android:src="@drawable/ic_folder_data"
            android:contentDescription="@string/title_activity_datasets"
            android:tooltipText="@string/title_activity_datasets"
            android:elevation="4dp"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/start_stop_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_record_shutter_idle"
            android:src="@drawable/ic_record_dot"
            android:contentDescription="@string/start"
            android:tooltipText="@string/start"
            android:elevation="6dp"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_side_button"
            android:src="@drawable/ic_settings_gear"
            android:contentDescription="@string/settings"
            android:tooltipText="@string/settings"
            android:elevation="4dp"
            app:tint="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
